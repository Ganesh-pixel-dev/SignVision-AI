# Copy to .env. Every value is optional.
SECRET_KEY=change-me
# Comma separated origins allowed to open the socket from another site. Empty means same origin only.
CORS_ORIGINS=
HOST=127.0.0.1
PORT=5001
WEBAPP_PORT=5000
CAMERA_INDEX=0
FLASK_DEBUG=0
# JSON list of WebRTC ICE servers. Empty means one public STUN server.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
ICE_SERVERS=
